# QuestionsHub production environment.
#
# On the VPS this lives at /srv/questions-hub/deploy/app.env, owned root:qh mode 0640 —
# the app user reads it, only root can change it. Copy real values from 1Password; never
# commit them (see the private infra repo's SECRETS.md for which item holds what).
#
#   sudo install -o root -g qh -m 0640 /dev/null /srv/questions-hub/deploy/app.env
#   sudo nano /srv/questions-hub/deploy/app.env

# ── Database ─────────────────────────────────────────────────────────
POSTGRES_ROOT_PASSWORD=
QUESTIONSHUB_PASSWORD=

# ── Seed admin account ───────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Mailjet (transactional email) ────────────────────────────────────
EMAIL_API_KEY=
EMAIL_API_SECRET=

# ── Telegram channel bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Deployment ───────────────────────────────────────────────────────
# Normally `latest`. To roll back, set this to a specific build tag (e.g. sha-1a2b3c4)
# and run /usr/local/bin/qh-deploy. Every CI build publishes both tags.
IMAGE_TAG=latest

# ── Paths (defaults match the standard /srv layout; override only if relocating) ──
# UPLOADS_PATH=/srv/questions-hub/uploads
# KEYS_PATH=/srv/questions-hub/keys
