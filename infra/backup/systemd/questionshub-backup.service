[Unit]
# USER unit — install to ~qh/.config/systemd/user/ and enable with:
#   systemctl --user enable --now questionshub-backup.timer
#
# It must be a user unit: pg_dump runs through qh's own ROOTLESS Docker socket, which lives in
# this user's runtime directory. That is also why the backup account no longer needs the `docker`
# group (root-equivalent) or membership of appgroup/GID 10000 to read keys/ — everything it
# touches is plainly qh-owned now. `loginctl enable-linger qh` keeps this firing without a login.
Description=QuestionsHub backup (db + files) via restic to OVH Object Storage
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/qh-backup
TimeoutStartSec=3600
