# QuestionsHub backup credentials.
#
# On the VPS: /srv/questions-hub/backup/backup.env, owned qh:qh mode 0600.
# DO NOT COMMIT REAL VALUES — they live in 1Password (see the private infra repo's SECRETS.md).
#
# This S3 key must be scoped to QuestionsHub's bucket only. AnkiLearner has its own bucket, its
# own key and its own RESTIC_PASSWORD: each app's backup contains that app's app.env, so a shared
# repository would be a cross-app secret leak.

# OVH Object Storage (S3) credentials
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
export AWS_DEFAULT_REGION="de"

# OVH endpoint + bucket
export OVH_S3_ENDPOINT="https://s3.de.io.cloud.ovh.net"
export OVH_S3_BUCKET="lucky-chandrasekhar"

# restic repository encryption password (client-side).
# This repository ALREADY EXISTS. Keep the existing value and skip `restic init` on a new host —
# a different password makes every existing snapshot undecryptable.
export RESTIC_PASSWORD=""

# Optional monitoring (Healthchecks.io)
export HC_URL=""
