@page "/question/{Id:int}"
@attribute [StreamRendering]
@using Microsoft.EntityFrameworkCore
@using QuestionsHub.Blazor.Data
@using QuestionsHub.Blazor.Domain
@using QuestionsHub.Blazor.Infrastructure
@inject QuestionsHubDbContext DbContext
@inject AccessControlService AccessControl

<PageTitle>@PageTitleText - База українських запитань</PageTitle>

@if (_notFound)
{
    <div class="container mt-4">
        <div class="alert alert-warning">
            <h4>Запитання не знайдено</h4>
            <p>Запитання з ідентифікатором @Id не існує або недоступне.</p>
            <a href="/" class="btn btn-primary">Повернутися на головну</a>
        </div>
    </div>
}
else if (_question == null)
{
    <div class="container mt-4">
        <p><em>Завантаження...</em></p>
    </div>
}
else
{
    <div class="container-fluid">
        <h4 class="mb-4">Запитання</h4>

        <div class="row">
            <div class="col-12 mb-4">
                <div class="card question-detail-card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <PackageTypeBadge Type="_question.Tour.Package.Type" Class="me-2" />
                            <a href="/package/@_question.Tour.PackageId" class="text-decoration-none fw-bold">@_question.Tour.Package.Title</a>
                            <span class="text-muted mx-2">·</span>
                            @if (_question.Tour.Package.Type == PackageType.Shvager)
                            {
                                <span class="text-muted">@_question.Tour.ThemeDisplayName</span>
                                <span class="text-muted mx-2">·</span>
                                <span class="text-muted">@_question.Number</span>
                            }
                            else
                            {
                                <span class="text-muted">Тур @_question.Tour.Number</span>
                                <span class="text-muted mx-2">·</span>
                                <span class="text-muted">Запитання @_question.Number</span>
                            }
                        </div>
                        <a href="/package/@_question.Tour.PackageId#question-@_question.Id"
                           class="btn btn-sm btn-outline-primary">
                            Перейти на пакет
                        </a>
                    </div>
                    <div class="card-body">
                        @if (_isAdult)
                        {
                            <div class="adult-blur-wrapper blurred" data-package-id="@_question.Tour.PackageId">
                                <div class="adult-reveal-overlay" onclick="revealAdultContent(this)">
                                    <span>🔞 Вміст 18+. Натисніть, щоб показати.</span>
                                </div>
                                <QuestionContent Question="_question" Type="_question.Tour.Package.Type" Stat="_stat" />
                            </div>
                        }
                        else
                        {
                            <QuestionContent Question="_question" Type="_question.Tour.Package.Type" Stat="_stat" />
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Question? _question;
    private bool _notFound;
    private bool _isAdult;
    private QuestionStat? _stat;

    private string PageTitleText => _question == null
        ? "Запитання"
        : _question.Tour.Package.Type == PackageType.Shvager
            ? $"{_question.Tour.ThemeDisplayName} · {_question.Number}"
            : $"Запитання {_question.Number}";

    protected override async Task OnInitializedAsync()
    {
        _question = await DbContext.Questions
            .AsNoTracking()
            .Include(q => q.Authors)
            .Include(q => q.Tour)
                .ThenInclude(t => t.Package)
                    .ThenInclude(p => p.Tags)
            .FirstOrDefaultAsync(q => q.Id == Id);

        if (_question == null)
        {
            _notFound = true;
            return;
        }

        // Check visibility based on package status and access level
        var accessContext = await AccessControl.GetPackageAccessContext();
        if (!accessContext.CanViewPackage(_question.Tour.Package))
        {
            _question = null;
            _notFound = true;
            return;
        }

        // Check if the package has 18+ content tag
        _isAdult = TagService.IsAdultContent(_question.Tour.Package.Tags);

        // Precomputed tournament statistics for the question (if any)
        _stat = await DbContext.QuestionStats
            .AsNoTracking()
            .FirstOrDefaultAsync(s => s.QuestionId == Id);
    }
}
