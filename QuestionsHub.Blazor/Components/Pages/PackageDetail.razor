@page "/package/{Id:int}"
@attribute [StreamRendering]
@using Microsoft.EntityFrameworkCore
@using QuestionsHub.Blazor.Data
@using QuestionsHub.Blazor.Domain
@using QuestionsHub.Blazor.Infrastructure
@using QuestionsHub.Blazor.Utils
@inject QuestionsHubDbContext DbContext
@inject AccessControlService AccessControl
@inject PackageResultsService PackageResults

<PageTitle>@(_package?.Title ?? "Пакет не знайдено") - База українських запитань</PageTitle>

@if (_notFound)
{
    <div class="container mt-4">
        <div class="alert alert-warning">
            <h4>Пакет не знайдено</h4>
            <p>Пакет з ідентифікатором @Id не існує або недоступний.</p>
            <a href="/" class="btn btn-primary">Повернутися на головну</a>
        </div>
    </div>
}
else if (_package == null)
{
    <div class="container mt-4">
        <p><em>Завантаження...</em></p>
    </div>
}
else
{
    <div class="container-fluid mt-4">
        <div class="row gx-3">
            <!-- Left Sidebar Navigation -->
            <div class="col-lg-2 package-sidebar">
                <TourNavigation Package="_package" />
            </div>

            <!-- Main Content -->
            <div class="col-lg-10 main-content">
                <div id="top">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h1 class="mb-0 d-inline align-middle">@_package.Title</h1>
                            <PackageTypeBadge Type="_package.Type" Class="ms-2 align-middle" />
                        </div>
                        @if (_canEdit)
                        {
                            <a href="/manage/package/@_package.Id" class="btn btn-outline-primary btn-sm ms-3">
                                <Icon Name="pencil" Class="me-1" />Редагувати
                            </a>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(_package.Description))
                    {
                        <p class="lead">@_package.Description</p>
                    }

                    @if (!string.IsNullOrEmpty(_package.Preamble))
                    {
                        <div class="preamble mb-3">
                            <p style="white-space: pre-line;">@_package.Preamble</p>
                        </div>
                    }

                    @if (_package.Editors.Any())
                    {
                        <p>
                            <strong>Редактори:</strong>
                            @{ var packageEditors = _package.Editors.ToList(); }
                            @for (var i = 0; i < packageEditors.Count; i++)
                            {
                                var editor = packageEditors[i];
                                @(" ")<a href="/editor/@editor.Id">@editor.FullName</a>@(i < packageEditors.Count - 1 ? "," : "")
                            }
                        </p>
                    }

                    @if (_package.Tags.Any())
                    {
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @foreach (var tag in _package.Tags)
                            {
                                <a href="/?tag=@tag.Id" class="badge rounded-pill bg-primary text-decoration-none">@tag.Name</a>
                            }
                        </div>
                    }

                    @{ var playedPeriod = PlayedPeriodFormatter.Format(_package.PlayedFrom, _package.PlayedTo); }
                    @if (!string.IsNullOrEmpty(playedPeriod))
                    {
                        <p>
                            <strong>Зіграно:</strong> @playedPeriod
                        </p>
                    }

                    @if (_package.PublicationDate.HasValue)
                    {
                        <p>
                            <strong>Дата публікації:</strong> <span data-utc="@_package.PublicationDate.Value.ToString("o")"></span>
                        </p>
                    }

                    @{
                        var loadedSources = _resultsSources.Where(s => s.LoadedAt != null && s.TeamsCount > 0).ToList();
                        var externalResultLinks = _resultsSources.Where(s => s.ShowExternalLink).ToList();
                    }
                    @if (loadedSources.Count > 0 || externalResultLinks.Count > 0)
                    {
                        <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
                            @if (loadedSources.Count > 0)
                            {
                                <a href="/package/@_package.Id/results" class="btn btn-primary btn-sm">
                                    <Icon Name="list-ul" Class="me-1" />Результати
                                </a>
                                <span class="text-muted small me-2">@loadedSources.Sum(s => s.TeamsCount ?? 0) команд</span>
                            }
                            @foreach (var source in externalResultLinks)
                            {
                                <a href="@source.DisplayUrl" target="_blank" rel="noopener noreferrer"
                                   class="results-source-icon"
                                   title="@(source.Title ?? ResultsDisplay.PlatformName(source.Platform))">
                                    <PlatformIcon Platform="source.Platform" />
                                </a>
                            }
                        </div>
                    }
                </div>

                <div class="d-flex gap-2 mb-3">
                    <button class="btn btn-outline-secondary btn-sm" onclick="toggleAllAnswers(this)">
                        <Icon Name="eye" Class="toggle-all-icon me-1" /><span class="toggle-all-label">Показати всі відповіді</span>
                    </button>
                </div>

                @if (_isAdult)
                {
                    <div class="adult-package-banner" id="adult-banner" data-package-id="@_package.Id">
                        🔞 Цей пакет містить контент 18+.
                        <button class="btn btn-outline-dark btn-sm" onclick="revealAllAdultContent()">
                            Мені є 18 років, показати вміст
                        </button>
                    </div>
                }

                <hr class="my-4" />

                @{
                    var blockNumberInPackage = 0;
                }
                @foreach (var tour in _package.Tours)
                {
                    <div id="tour-@tour.Id" class="tour-section">
                        <div class="tour-heading">
                            <h2 class="mb-0">
                                @if (_package.Type == PackageType.Shvager)
                                {
                                    @tour.ThemeDisplayName
                                }
                                else if (tour.IsWarmup)
                                {
                                    <text>Розминка</text>
                                }
                                else if (tour.IsShootout)
                                {
                                    <text>Перестрілка</text>
                                }
                                else
                                {
                                    <text>Тур @tour.Number</text>
                                }
                            </h2>
                            <button class="btn btn-sm copy-link-btn"
                                    onclick="copyTourLink(this, @_package.Id, @tour.Id)"
                                    title="@(_package.Type == PackageType.Shvager ? "Скопіювати посилання на тему" : "Скопіювати посилання на тур")">
                                <Icon Name="link" Class="copy-icon" />
                            </button>
                        </div>

                        @if (tour.HasBlocks)
                        {
                            @* Tour with blocks - display each block with its questions *@
                            @foreach (var block in tour.Blocks.OrderBy(b => b.OrderIndex))
                            {
                                blockNumberInPackage++;
                                <div id="block-@block.Id" class="block-section">
                                    <h4 class="block-header">
                                        @block.GetDisplayName(blockNumberInPackage)
                                    </h4>

                                    @if (block.Editors.Any())
                                    {
                                        <p>
                                            <small>
                                                <strong>Редактори блоку:</strong>
                                                @for (var i = 0; i < block.Editors.Count; i++)
                                                {
                                                    var editor = block.Editors[i];
                                                    @(" ")<a href="/editor/@editor.Id">@editor.FullName</a>@(i < block.Editors.Count - 1 ? "," : "")
                                                }
                                            </small>
                                        </p>
                                    }

                                    @if (!string.IsNullOrEmpty(block.Preamble))
                                    {
                                        <div class="preamble mb-3">
                                            <p style="white-space: pre-line;">@block.Preamble</p>
                                        </div>
                                    }

                                    @foreach (var question in tour.Questions.Where(q => q.BlockId == block.Id).OrderBy(q => q.OrderIndex))
                                    {
                                        <div id="question-@question.Id">
                                            <QuestionCard Question="@question" IsBlurred="_isAdult" Type="_package.Type" Stat="@_questionStats.GetValueOrDefault(question.Id)" />
                                        </div>
                                    }
                                </div>
                            }

                            @* Display orphan questions (not assigned to any block) after all blocks *@
                            var orphanQuestions = tour.Questions.Where(q => q.BlockId == null).OrderBy(q => q.OrderIndex).ToList();
                            if (orphanQuestions.Any())
                            {
                                <div class="orphan-questions-section">
                                    @foreach (var question in orphanQuestions)
                                    {
                                        <div id="question-@question.Id">
                                            <QuestionCard Question="@question" IsBlurred="_isAdult" Type="_package.Type" Stat="@_questionStats.GetValueOrDefault(question.Id)" />
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            @* Tour without blocks - existing behavior *@
                            @if (tour.Editors.Any())
                            {
                                <p>
                                    <small>
                                        <strong>@(_package.Type == PackageType.Shvager ? "Автори теми:" : "Редактори туру:")</strong>
                                        @for (var i = 0; i < tour.Editors.Count; i++)
                                        {
                                            var editor = tour.Editors[i];
                                            @(" ")<a href="/editor/@editor.Id">@editor.FullName</a>@(i < tour.Editors.Count - 1 ? "," : "")
                                        }
                                    </small>
                                </p>
                            }

                            @if (!string.IsNullOrEmpty(tour.Preamble))
                            {
                                <div class="preamble mb-3">
                                    <p style="white-space: pre-line;">@tour.Preamble</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(tour.Comment))
                            {
                                <p class="small">@tour.Comment</p>
                            }

                            @foreach (var question in tour.Questions.OrderBy(q => q.OrderIndex))
                            {
                                <div id="question-@question.Id">
                                    <QuestionCard Question="@question" IsBlurred="_isAdult" Type="_package.Type" Stat="@_questionStats.GetValueOrDefault(question.Id)" />
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Package? _package;
    private bool _notFound;
    private bool _canEdit;
    private bool _isAdult;
    private List<ResultsSourceInfo> _resultsSources = [];
    private Dictionary<int, QuestionStat> _questionStats = new();

    protected override async Task OnInitializedAsync()
    {
        _package = await DbContext.Packages
            .AsNoTracking()
            .Include(p => p.PackageEditors)
            .Include(p => p.Tags)
            .Include(p => p.Tours)
                .ThenInclude(t => t.Editors)
            .Include(p => p.Tours)
                .ThenInclude(t => t.Blocks)
                    .ThenInclude(b => b.Editors)
            .Include(p => p.Tours)
                .ThenInclude(t => t.Questions)
                    .ThenInclude(q => q.Authors)
            .FirstOrDefaultAsync(p => p.Id == Id);

        if (_package == null)
        {
            _notFound = true;
            return;
        }

        // Check visibility based on package status and access level
        var accessContext = await AccessControl.GetPackageAccessContext();
        if (!accessContext.CanViewPackage(_package))
        {
            _package = null;
            _notFound = true;
            return;
        }

        // Check if the current user can edit the package
        _canEdit = await AccessControl.CanEditPackage(_package);

        // Check if the package has 18+ content tag
        _isAdult = TagService.IsAdultContent(_package.Tags);

        // Tournament results: attached sources (header links) + precomputed per-question stats
        if (_package.Type == PackageType.Www)
        {
            _resultsSources = await PackageResults.GetSourcesForPackage(_package.Id);

            if (_resultsSources.Any(s => s.StatsMapped))
            {
                _questionStats = await DbContext.QuestionStats
                    .AsNoTracking()
                    .Where(s => s.Question.Tour.PackageId == Id)
                    .ToDictionaryAsync(s => s.QuestionId);
            }
        }

        // Sort tours by Number (ЩДК: warmup "0" first, shootout "П" last) or by OrderIndex (Своя гра),
        // blocks by OrderIndex, and questions by OrderIndex
        _package.Tours = _package.Type == PackageType.Shvager
            ? _package.Tours.OrderBy(t => t.OrderIndex).ToList()
            : TourOrdering.OrderWww(_package.Tours);

        foreach (var tour in _package.Tours)
        {
            tour.Blocks = tour.Blocks
                .OrderBy(b => b.OrderIndex)
                .ToList();

            tour.Questions = tour.Questions
                .OrderBy(q => q.OrderIndex)
                .ToList();
        }
    }
}

