@page "/editor/{Id:int}"
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@inject NavigationManager Navigation

@inject IDbContextFactory<QuestionsHubDbContext> DbContextFactory
@inject AuthorService AuthorService
@inject AccessControlService AccessControl
@inject FavoriteService Favorites

@* Plain server-rendered page: the views and "show more" are links (?view=questions&shown=40),
   the admin tools are ordinary POST forms. *@

<PageTitle>@(_author?.FullName ?? "Редактора не знайдено")</PageTitle>

<div class="container py-4">
    @if (_author == null)
    {
        <div class="alert alert-warning" role="alert">
            <Icon Name="exclamation-triangle" Class="me-2" />Редактора не знайдено
        </div>
        <a href="/" class="btn btn-secondary">Повернутися на головну</a>
    }
    else
    {
        <h1 class="mb-4">@_author.FullName</h1>

        <!-- Linked User Section (Admin Only) -->
        @if (_isAdmin)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <Icon Name="person-badge" Class="me-2" />Пов'язаний користувач
                </div>
                <div class="card-body">
                    @if (_linkedUser != null)
                    {
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <strong>@_linkedUser.FullName</strong>
                                <br/>
                                <small class="text-muted">@_linkedUser.Email</small>
                                @if (!string.IsNullOrEmpty(_linkedUser.City))
                                {
                                    <br/>
                                    <small class="text-muted">@_linkedUser.City</small>
                                }
                            </div>
                            <form method="post" @formname="unlink-user" @onsubmit="UnlinkUser">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <Icon Name="link" Class="me-1" />Від'єднати
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Автор не пов'язаний з жодним користувачем.</p>
                        <hr/>
                        <form method="post" @formname="link-user" @onsubmit="LinkUser" class="row g-3 align-items-end">
                            <AntiforgeryToken />
                            <div class="col-md-8">
                                <label class="form-label" for="link-user-id">Обрати користувача для зв'язування:</label>
                                <select class="form-select" id="link-user-id" name="LinkUserId" required>
                                    <option value="">-- Оберіть користувача --</option>
                                    @foreach (var user in _availableUsers)
                                    {
                                        <option value="@user.Id">@user.FullName (@user.Email)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-primary">
                                    <Icon Name="link" Class="me-1" />Пов'язати
                                </button>
                            </div>
                        </form>
                    }

                    @if (!string.IsNullOrEmpty(_linkMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0" role="alert">
                            @_linkMessage
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Merge Author Section (Admin Only) -->
        @if (_isAdmin)
        {
            <div class="card mb-4 border-warning">
                <div class="card-header">
                    <Icon Name="arrow-repeat" Class="me-2" />Об'єднати з іншим автором
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        Якщо це дублікат з помилкою в імені, знайдіть правильного автора — усі запитання
                        та пакети буде перенесено до нього, а автора «<strong>@_author.FullName</strong>» видалено.
                    </p>

                    <form method="get" class="d-flex gap-2 mb-2" style="max-width: 400px;">
                        <input type="text" name="merge" class="form-control" value="@MergeQuery"
                               placeholder="Прізвище правильного автора..." aria-label="Правильний автор" />
                        <button type="submit" class="btn btn-outline-secondary">Знайти</button>
                    </form>

                    @if (!string.IsNullOrWhiteSpace(MergeQuery))
                    {
                        @if (_mergeCandidates.Count > 0)
                        {
                            @* Each candidate is a submit button; forms.js asks for confirmation first *@
                            <form method="post" @formname="merge-author" @onsubmit="MergeIntoTarget"
                                  data-confirm="Об'єднати авторів? Дію не можна скасувати." style="max-width: 400px;">
                                <AntiforgeryToken />
                                <div class="small text-muted mb-1">Перенести все до:</div>
                                <div class="list-group">
                                    @foreach (var candidate in _mergeCandidates)
                                    {
                                        <button type="submit" name="MergeTargetId" value="@candidate.Id"
                                                class="list-group-item list-group-item-action"
                                                data-confirm="@($"Об'єднати «{_author.FullName}» → «{candidate.FullName}»? Дію не можна скасувати.")">
                                            <Icon Name="arrow-repeat" Class="me-1" />@candidate.FullName
                                        </button>
                                    }
                                </div>
                            </form>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Авторів не знайдено.</p>
                        }
                    }

                    @if (!string.IsNullOrEmpty(_mergeMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0" role="alert">
                            @_mergeMessage
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Statistics Section: each card switches the list below -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card h-100 @(ShowQuestions ? "" : "border-primary")">
                    <div class="card-header">
                        <a href="@ViewUrl(questions: false)" class="stretched-link text-reset text-decoration-none">
                            <Icon Name="box" Class="me-2" />Пакети
                        </a>
                    </div>
                    <div class="card-body">
                        <h3 class="card-title">@(_stats?.PackageCount ?? 0)</h3>
                        <p class="card-text text-muted mb-1">пакетів, де @_author.FirstName є редактором</p>
                        <p class="card-text small text-muted mb-0">@TypeBreakdown(_stats?.WwwPackageCount ?? 0, _stats?.ShvagerPackageCount ?? 0)</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100 @(ShowQuestions ? "border-primary" : "")">
                    <div class="card-header">
                        <a href="@ViewUrl(questions: true)" class="stretched-link text-reset text-decoration-none">
                            <Icon Name="question-circle" Class="me-2" />Запитання
                        </a>
                    </div>
                    <div class="card-body">
                        <h3 class="card-title">@(_stats?.QuestionCount ?? 0)</h3>
                        <p class="card-text text-muted mb-1">запитань, де @_author.FirstName є автором</p>
                        <p class="card-text small text-muted mb-0">@TypeBreakdown(_stats?.WwwQuestionCount ?? 0, _stats?.ShvagerQuestionCount ?? 0)</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Packages List Section -->
        @if (!ShowQuestions && _packagesList.Count > 0)
        {
            <div class="card mb-4" id="packages-list">
                <div class="card-header">
                    <Icon Name="list-ul" Class="me-2" />Список пакетів
                </div>
                <div class="card-body">
                    @foreach (var group in PackageGroups())
                    {
                        @if (_hasBothTypes)
                        {
                            <h6 class="mt-2">
                                <PackageTypeBadge Type="group.Key" FullName="true" />
                            </h6>
                        }
                        <ul class="list-unstyled">
                            @foreach (var packageItem in group)
                            {
                                <li class="mb-2 anchor-target" id="package-@packageItem.PackageId">
                                    <a href="/package/@packageItem.PackageId">@packageItem.PackageTitle</a>
                                    @if (!packageItem.IsGlobalEditor && packageItem.Tours.Any())
                                    {
                                        @TourSeparator
                                        @foreach (var (entry, isLast) in GetPackageEntries(packageItem))
                                        {
                                            <a href="@entry.Href">@entry.Text</a>
                                            @if (!isLast)
                                            {
                                                @(" | ")
                                            }
                                        }
                                    }
                                </li>
                            }
                        </ul>
                    }
                    @if (_packagesList.Count > ShownCount)
                    {
                        @* Reloads with more items and jumps to the first new one *@
                        <a class="btn btn-link"
                           href="@ViewUrl(questions: false, ShownCount + PageSize, $"package-{_packagesList[ShownCount].PackageId}")">
                            показати більше
                        </a>
                    }
                </div>
            </div>
        }

        <!-- Questions List Section -->
        @if (ShowQuestions)
        {
            <div class="mb-4" id="questions-list">
                <h4 class="mb-3">Список питань</h4>
                @if (_questionsList.Count > 0)
                {
                    @foreach (var question in _questionsList)
                    {
                        <div class="anchor-target" id="question-@question.Id">
                            <QuestionCard Question="@question" ShowFullHeader="true" IsBlurred="TagService.IsAdultContent(question.Tour.Package.Tags)" Favorites="_favorites" />
                        </div>
                    }
                    @if (_nextQuestionId is { } nextQuestionId)
                    {
                        <div class="text-center mt-3">
                            <a class="btn btn-primary" href="@ViewUrl(questions: true, ShownCount + PageSize, $"question-{nextQuestionId}")">
                                Показати більше
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        <p class="mb-0">Запитання не знайдено.</p>
                    </div>
                }
            </div>
        }

        <a href="/" class="btn btn-secondary">
            <Icon Name="arrow-left" Class="me-1" />Повернутися на головну
        </a>
    }
</div>

@code {
    private const int PageSize = 20;

    /// <summary>Upper bound for <see cref="Shown"/>, so a hand-made URL cannot ask for an author's every question.</summary>
    private const int MaxShown = 1000;

    private const string TourSeparator = " → ";

    [Parameter]
    public int Id { get; set; }

    /// <summary>"questions" lists the author's questions; anything else lists their packages.</summary>
    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    /// <summary>How many items of the current list are shown ("show more" adds a page); text, so junk falls back to a page.</summary>
    [SupplyParameterFromQuery(Name = "shown")]
    public string? Shown { get; set; }

    /// <summary>Admin: the name searched for as the author to merge this one into.</summary>
    [SupplyParameterFromQuery(Name = "merge")]
    public string? MergeQuery { get; set; }

    [SupplyParameterFromForm(FormName = "link-user")]
    private string? LinkUserId { get; set; }

    [SupplyParameterFromForm(FormName = "merge-author")]
    private int? MergeTargetId { get; set; }

    private bool ShowQuestions => View == "questions";
    private int ShownCount => Math.Clamp(
        int.TryParse(Shown, NumberStyles.Integer, CultureInfo.InvariantCulture, out var shown) ? shown : PageSize,
        PageSize, MaxShown);

    private Author? _author;
    private bool _isAdmin;
    private AuthorStatistics? _stats;
    private List<AuthorPackageListItem> _packagesList = [];
    private bool _hasBothTypes;
    private List<Question> _questionsList = [];
    private FavoriteLookup? _favorites;

    /// <summary>The first question beyond the shown ones, if any: the "show more" link jumps to it.</summary>
    private int? _nextQuestionId;

    // Admin tools
    private UserForLinking? _linkedUser;
    private List<UserForLinking> _availableUsers = [];
    private string? _linkMessage;
    private List<Author> _mergeCandidates = [];
    private string? _mergeMessage;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await AccessControl.IsAdmin();

        await using var context = await DbContextFactory.CreateDbContextAsync();
        _author = await context.Authors
            .AsNoTracking()
            .FirstOrDefaultAsync(a => a.Id == Id);

        if (_author == null) return;

        var accessContext = await AccessControl.GetPackageAccessContext();
        _stats = await AuthorService.GetAuthorStatistics(Id, accessContext);
        _packagesList = await AuthorService.GetAuthorPackages(Id, accessContext);
        _hasBothTypes = _packagesList.Select(p => p.Type).Distinct().Count() > 1;

        if (ShowQuestions)
        {
            await LoadQuestions(context, accessContext);
        }

        if (_isAdmin)
        {
            await LoadLinkedUser();
            if (!string.IsNullOrWhiteSpace(MergeQuery))
            {
                // Exclude the current author — you cannot merge someone into themselves.
                _mergeCandidates = (await AuthorService.SearchAuthors(MergeQuery.Trim(), 10))
                    .Where(a => a.Id != Id)
                    .ToList();
            }
        }
    }

    /// <summary>The first <see cref="ShownCount"/> of the author's questions in accessible published packages.</summary>
    private async Task LoadQuestions(QuestionsHubDbContext context, PackageAccessContext accessContext)
    {
        var accessiblePackageIds = context.Packages
            .Where(accessContext.GetAccessFilter())
            .Select(p => p.Id);

        // One extra row tells whether there is more, and where "show more" should land
        var questions = await context.Questions
            .AsNoTracking()
            .Where(q => q.Authors.Any(a => a.Id == Id))
            .Where(q => q.Tour.Package.Status == PackageStatus.Published)
            .Where(q => accessiblePackageIds.Contains(q.Tour.PackageId))
            .Include(q => q.Authors)
            .Include(q => q.Tour)
                .ThenInclude(t => t.Package)
                    .ThenInclude(p => p.Tags)
            .OrderByDescending(q => q.Tour.PackageId)
            .ThenBy(q => q.Tour.Number)
            .ThenBy(q => q.OrderIndex)
            .ThenBy(q => q.Id) // a total order: "show more" re-queries and must list the same questions first
            .Take(ShownCount + 1)
            .ToListAsync();

        _nextQuestionId = questions.Count > ShownCount ? questions[ShownCount].Id : null;
        _questionsList = questions.Take(ShownCount).ToList();
        _favorites = await Favorites.GetLookupForQuestions(accessContext, _questionsList.Select(q => q.Id));
    }

    private async Task LoadLinkedUser()
    {
        _linkedUser = await AuthorService.GetLinkedUser(Id);
        _availableUsers = _linkedUser == null ? await AuthorService.GetAvailableUsersForLinking() : [];
    }

    /// <summary>Link to this page's packages or questions list, optionally longer and scrolled to an item.</summary>
    private string ViewUrl(bool questions, int? shown = null, string? anchor = null)
    {
        var query = new List<string>();
        if (questions) query.Add("view=questions");
        if (shown is > PageSize) query.Add($"shown={shown}");

        return $"/editor/{Id}"
               + (query.Count > 0 ? "?" + string.Join("&", query) : "")
               + (anchor != null ? "#" + anchor : "");
    }

    /// <summary>
    /// Groups the visible packages by game type: Що?Де?Коли? first, then Своя гра.
    /// </summary>
    private IEnumerable<IGrouping<PackageType, AuthorPackageListItem>> PackageGroups()
        => _packagesList
            .Take(ShownCount)
            .GroupBy(p => p.Type)
            .OrderBy(g => g.Key);

    /// <summary>Per-type breakdown line for the statistics cards, e.g. «ЩДК: 5 · Своя гра: 2».</summary>
    private static string TypeBreakdown(int wwwCount, int shvagerCount)
        => $"{PackageType.Www.ShortName()}: {wwwCount} · {PackageType.Shvager.ShortName()}: {shvagerCount}";

    private IEnumerable<((string Text, string Href) Entry, bool IsLast)> GetPackageEntries(AuthorPackageListItem packageItem)
    {
        var allEntries = new List<(string Text, string Href)>();

        foreach (var tour in packageItem.Tours)
        {
            if (packageItem.Type == PackageType.Shvager)
            {
                // Своя гра theme - show its title (fallback to «Тема N»)
                allEntries.Add((
                    string.IsNullOrWhiteSpace(tour.TourTitle) ? $"Тема {tour.TourNumber}" : tour.TourTitle,
                    $"/package/{packageItem.PackageId}#tour-{tour.TourId}"
                ));
            }
            else if (tour.Blocks.Any())
            {
                // Tour has blocks - show tour => block N for each block
                foreach (var block in tour.Blocks)
                {
                    allEntries.Add((
                        $"Тур {tour.TourNumber} → Блок {block.BlockNumber}",
                        $"/package/{packageItem.PackageId}#block-{block.BlockId}"
                    ));
                }
            }
            else
            {
                // Tour without blocks - just show tour
                allEntries.Add((
                    $"Тур {tour.TourNumber}",
                    $"/package/{packageItem.PackageId}#tour-{tour.TourId}"
                ));
            }
        }

        for (var i = 0; i < allEntries.Count; i++)
        {
            yield return (allEntries[i], i == allEntries.Count - 1);
        }
    }

    private async Task LinkUser()
    {
        if (!_isAdmin || string.IsNullOrEmpty(LinkUserId))
            return;

        ReloadOrShowError(await AuthorService.LinkAuthorToUser(Id, LinkUserId));
    }

    private async Task UnlinkUser()
    {
        if (!_isAdmin)
            return;

        ReloadOrShowError(await AuthorService.UnlinkAuthorFromUser(Id));
    }

    /// <summary>
    /// Success → redirect to the page (post/redirect/get), so a refresh doesn't re-post a form that is
    /// no longer on the page (Blazor answers that with a bare 400).
    /// </summary>
    private void ReloadOrShowError(AuthorOperationResult result)
    {
        if (result.Success)
        {
            Navigation.NavigateTo($"/editor/{Id}", forceLoad: true);
            return;
        }

        _linkMessage = result.Message;
    }

    private async Task MergeIntoTarget()
    {
        if (!_isAdmin || MergeTargetId is not { } targetId || targetId == Id)
            return;

        var result = await AuthorService.MergeAuthors(Id, targetId);
        if (result.Success)
        {
            // The current (source) author is deleted; continue on the surviving author's page.
            Navigation.NavigateTo($"/editor/{targetId}", forceLoad: true);
            return;
        }

        _mergeMessage = result.Message;
    }
}
