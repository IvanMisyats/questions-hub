@*
    Reusable pagination component with icon-based navigation (plain links).
    Usage: <Pagination CurrentPage="1" TotalPages="5" BaseUrl="/packages" />
    Usage with JS interception: <Pagination CurrentPage="1" TotalPages="5" BaseUrl="/packages" JsIntercepted="true" />
*@

@if (CurrentPage > 1 || TotalPages > 1)
{
    <nav aria-label="Навігація по сторінках" class="pagination-nav mt-3">
        <div class="pagination-container">
            @* First page *@
            <a class="pagination-btn @(CurrentPage <= 1 ? "disabled" : "")"
               href="@GetLinkHref(1, CurrentPage <= 1)"
               data-page="@(JsIntercepted ? 1 : null)"
               title="Перша сторінка">
                <Icon Name="chevron-double-left" Size="16" />
            </a>

            @* Previous page *@
            <a class="pagination-btn @(CurrentPage <= 1 ? "disabled" : "")"
               href="@GetLinkHref(CurrentPage - 1, CurrentPage <= 1)"
               data-page="@(JsIntercepted ? CurrentPage - 1 : null)"
               title="Попередня сторінка">
                <Icon Name="chevron-left" Size="16" />
            </a>

            @* Page numbers *@
            <div class="pagination-numbers">
                @foreach (var pageNumber in GetVisiblePages())
                {
                    <a class="pagination-btn pagination-number @(pageNumber == CurrentPage ? "active" : "")"
                       href="@GetLinkHref(pageNumber, pageNumber == CurrentPage)"
                       data-page="@(JsIntercepted ? pageNumber : null)">
                        @pageNumber
                    </a>
                }
            </div>

            @* Next page *@
            <a class="pagination-btn @(!HasNext ? "disabled" : "")"
               href="@GetLinkHref(CurrentPage + 1, !HasNext)"
               data-page="@(JsIntercepted ? CurrentPage + 1 : null)"
               title="Наступна сторінка">
                <Icon Name="chevron-right" Size="16" />
            </a>

            @* Last page *@
            <a class="pagination-btn @(!HasNext ? "disabled" : "")"
               href="@GetLinkHref(TotalPages, !HasNext)"
               data-page="@(JsIntercepted ? TotalPages : null)"
               title="Остання сторінка">
                <Icon Name="chevron-double-right" Size="16" />
            </a>
        </div>
    </nav>
}

@code {
    /// <summary>
    /// Current page number (1-based).
    /// </summary>
    [Parameter, EditorRequired]
    public int CurrentPage { get; set; } = 1;

    /// <summary>
    /// Total number of pages.
    /// </summary>
    [Parameter, EditorRequired]
    public int TotalPages { get; set; }

    /// <summary>
    /// Base URL of the pages.
    /// Example: "/packages" generates "/packages/2", "/packages/3", etc.
    /// Use empty string "" for root-level pages like "/" -> "/2", "/3".
    /// </summary>
    [Parameter, EditorRequired]
    public string BaseUrl { get; set; } = "";

    /// <summary>
    /// When true, links use href="#" with data-page attributes for JS interception.
    /// The actual page URL is still available in data-page for JS to construct the URL.
    /// </summary>
    [Parameter]
    public bool JsIntercepted { get; set; }

    private bool HasNext => CurrentPage < TotalPages;

    private string? GetLinkHref(int page, bool isDisabled)
    {
        if (isDisabled) return null;
        return JsIntercepted ? "#" : GetPageUrl(page);
    }

    private string GetPageUrl(int page)
    {
        if (string.IsNullOrEmpty(BaseUrl))
        {
            return page <= 1 ? "/" : $"/{page}";
        }

        // Check if BaseUrl contains query string
        var queryIndex = BaseUrl.IndexOf('?');
        if (queryIndex >= 0)
        {
            var path = BaseUrl[..queryIndex];
            var query = BaseUrl[queryIndex..];
            return page <= 1 ? BaseUrl : $"{path}/{page}{query}";
        }

        return page <= 1 ? BaseUrl : $"{BaseUrl}/{page}";
    }

    private IEnumerable<int> GetVisiblePages()
    {
        // If 10 or fewer pages, show all
        if (TotalPages <= 10)
        {
            for (var i = 1; i <= TotalPages; i++)
            {
                yield return i;
            }
            yield break;
        }

        // For many pages, show first, last, and pages around current
        var pagesToShow = new HashSet<int> { 1, TotalPages };
        for (var i = Math.Max(1, CurrentPage - 2); i <= Math.Min(TotalPages, CurrentPage + 2); i++)
        {
            pagesToShow.Add(i);
        }

        foreach (var page in pagesToShow.OrderBy(p => p))
        {
            yield return page;
        }
    }
}
