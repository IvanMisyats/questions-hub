@using Microsoft.AspNetCore.Components.Sections
@*
    Loads Blazor's script (blazor.web.js) at the end of <body>, through App.razor's outlet.
    Only interactive editor/admin tools need it; public pages must work without it, because
    Safari before 16.4 cannot parse it. App.razor adds it on @rendermode pages; a static page
    with an interactive part renders <BlazorScript /> next to that part, for the users who see it.
*@
<SectionContent SectionName="@SectionName">
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
    <script src="@Assets["sortable-interop.js"]"></script>
    <script>
        // blazor.web.js resumes an evicted circuit with Promise.withResolvers (Safari 17.4+)
        if (!Promise.withResolvers) {
            Promise.withResolvers = function () {
                let resolve, reject;
                const promise = new Promise(function (res, rej) { resolve = res; reject = rej; });
                return { promise: promise, resolve: resolve, reject: reject };
            };
        }
    </script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        if (window.Blazor) {
            // Every page loads in full, as without this script: no enhanced navigation or form handling.
            // So NavigationManager.NavigateTo must always pass forceLoad: true (NavigateToTests).
            Blazor.start({ ssr: { disableDomPreservation: true } });
        } else {
            // The browser could not parse blazor.web.js (Safari before 16.4): say so instead of dead buttons
            document.body.insertAdjacentHTML('afterbegin',
                '<div class="alert alert-warning rounded-0 mb-0 text-center">Інструменти редактора потребують новішого браузера (на iPhone — iOS 16.4 або новіша).</div>');
        }
    </script>
</SectionContent>

@code {
    public const string SectionName = "blazor-script";
}
