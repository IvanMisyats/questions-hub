@page "/Account/Profile"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using QuestionsHub.Blazor.Domain
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Мій профіль</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow">
                <div class="card-body">
                    <h3 class="card-title mb-4">Редагувати профіль</h3>

                    @if (_successMessage != null)
                    {
                        <div class="alert alert-success" role="alert">
                            @_successMessage
                        </div>
                    }

                    @if (_errorMessage != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @_errorMessage
                        </div>
                    }

                    @if (Model != null)
                    {
                        @* Posts to the plain URL, so a "saved" note from an earlier submit does not stay *@
                        <EditForm Model="@Model" OnValidSubmit="@HandleUpdateProfile" FormName="ProfileForm" action="/Account/Profile">
                            <DataAnnotationsValidator />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="firstName" class="form-label">Ім'я</label>
                                    <InputText id="firstName" @bind-Value="Model.FirstName" class="form-control" disabled />
                                    <small class="form-text text-muted">Ім'я не можна змінити</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="lastName" class="form-label">Прізвище</label>
                                    <InputText id="lastName" @bind-Value="Model.LastName" class="form-control" disabled />
                                    <small class="form-text text-muted">Прізвище не можна змінити</small>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="city" class="form-label">Місто</label>
                                    <InputText id="city" @bind-Value="Model.City" class="form-control" maxlength="100" />
                                    <ValidationMessage For="() => Model.City" class="text-danger small" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="team" class="form-label">Команда</label>
                                    <InputText id="team" @bind-Value="Model.Team" class="form-control" maxlength="100" />
                                    <ValidationMessage For="() => Model.Team" class="text-danger small" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <InputText id="email" @bind-Value="Model.Email" class="form-control" disabled />
                                <small class="form-text text-muted">Email не можна змінити</small>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary">Зберегти зміни</button>
                                <a href="/" class="btn btn-outline-secondary">Скасувати</a>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (_showAgentTokens)
    {
        <div class="row justify-content-center mt-4 mb-5">
            <div class="col-lg-10 col-xl-9">
                @* The only interactive part of the page, so only editors and admins load Blazor's script *@
                <AgentTokens @rendermode="InteractiveServer" />
                <BlazorScript />
            </div>
        </div>
    }
</div>

@code {
    /// <summary>The posted form on submit; built from the user on a plain visit.</summary>
    [SupplyParameterFromForm(FormName = "ProfileForm")]
    private ProfileModel? Model { get; set; }

    /// <summary>Set by the redirect after a successful save (post/redirect/get).</summary>
    [SupplyParameterFromQuery(Name = "saved")]
    public string? Saved { get; set; }

    /// <summary>Editors and admins may create agent tokens.</summary>
    private bool _showAgentTokens;
    private string? _successMessage;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (Saved != null)
            _successMessage = "Профіль успішно оновлено!";

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var appUser = await UserManager.GetUserAsync(user);
            if (appUser != null)
            {
                // A submit posts only City and Team (the other fields are disabled), so the
                // read-only ones always come from the user — they must be present to validate
                Model ??= new ProfileModel { City = appUser.City, Team = appUser.Team };
                Model.FirstName = appUser.FirstName;
                Model.LastName = appUser.LastName;
                Model.Email = appUser.Email ?? "";

                _showAgentTokens = user.IsInRole("Admin") || user.IsInRole("Editor");
            }
        }
    }

    private async Task HandleUpdateProfile()
    {
        _successMessage = null;
        _errorMessage = null;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var appUser = await UserManager.GetUserAsync(user);

        if (appUser != null && Model != null)
        {
            appUser.City = Model.City;
            appUser.Team = Model.Team;

            var result = await UserManager.UpdateAsync(appUser);

            if (result.Succeeded)
            {
                // Redirect, so refreshing the page does not post the form again
                Navigation.NavigateTo("/Account/Profile?saved=1", forceLoad: true);
            }
            else
            {
                _errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            }
        }
    }
}

