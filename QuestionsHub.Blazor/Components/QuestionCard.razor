@using QuestionsHub.Blazor.Domain

<div class="question-card" data-question-id="@Question.Id">
    <div class="question-header">
        @if (ShowFullHeader && Question.Tour?.Package != null)
        {
            <span class="question-number">
                <a href="/package/@Question.Tour.PackageId" class="text-decoration-none fw-bold">@Question.Tour.Package.Title</a>
                <span class="text-muted mx-1">→</span>
                @if (Question.Tour.Package.Type == PackageType.Shvager)
                {
                    <span class="text-muted">@Question.Tour.ThemeDisplayName</span>
                    <span class="text-muted mx-1">→</span>
                    <span class="text-muted fw-normal">@Question.Number</span>
                }
                else
                {
                    <span class="text-muted">Тур @Question.Tour.Number</span>
                    <span class="text-muted mx-1">→</span>
                    <span class="text-muted fw-normal">Запитання @Question.Number</span>
                }
            </span>
        }
        else if (EffectiveType == PackageType.Shvager)
        {
            <span class="question-number">@Question.Number</span>
        }
        else
        {
            <span class="question-number">Запитання @Question.Number</span>
        }
        <button class="btn btn-sm copy-link-btn"
                onclick="copyQuestionLink(this, @Question.Id)"
                title="Скопіювати посилання на запитання">
            <Icon Name="link" Class="copy-icon" />
        </button>
    </div>

    @if (IsBlurred)
    {
        <div class="adult-blur-wrapper blurred" data-package-id="@Question.Tour?.PackageId">
            <div class="adult-reveal-overlay" onclick="revealAdultContent(this)">
                <span>🔞 Вміст 18+. Натисніть, щоб показати.</span>
            </div>
            <QuestionContent Question="Question" Type="EffectiveType" ShowAnswer="false" Stat="Stat">
                <button class="answer-toggle" onclick="toggleAnswer(this)">
                    <span class="answer-toggle-label">Показати відповідь</span>
                    <Icon Name="chevron-down" Class="answer-toggle-icon" Size="14" />
                </button>
            </QuestionContent>
        </div>
    }
    else
    {
        <QuestionContent Question="Question" ShowAnswer="false" Stat="Stat">
            <button class="answer-toggle" onclick="toggleAnswer(this)">
                <span class="answer-toggle-label">Показати відповідь</span>
                <Icon Name="chevron-down" Class="answer-toggle-icon" Size="14" />
            </button>
        </QuestionContent>
    }
</div>

@code {
    [Parameter]
    public required Question Question { get; set; }

    /// <summary>
    /// Game type of the question's package. Controls the header:
    /// «Запитання N» for Що?Де?Коли?, the bare value (e.g. «40») for Своя гра.
    /// When not supplied, falls back to the loaded Tour.Package navigation (if any).
    /// </summary>
    [Parameter]
    public PackageType? Type { get; set; }

    /// <summary>
    /// When true, displays full breadcrumb header: "Package Title → Тур N → Запитання N"
    /// </summary>
    [Parameter]
    public bool ShowFullHeader { get; set; }

    /// <summary>
    /// When true, blurs question content with a click-to-reveal overlay (for 18+ packages).
    /// </summary>
    [Parameter]
    public bool IsBlurred { get; set; }

    /// <summary>Optional tournament statistics for the question, passed through to the content.</summary>
    [Parameter]
    public QuestionStat? Stat { get; set; }

    private PackageType EffectiveType => Type ?? Question.Tour?.Package?.Type ?? PackageType.Www;
}
