@using Microsoft.AspNetCore.Components.Endpoints
<!DOCTYPE html>
<html lang="uk">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <ImportMap />
    <script>
        (function() {
            const stored = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = stored || (prefersDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', theme);
            // Prevent sidebar collapse flash on refresh
            if (localStorage.getItem('sidebar-collapsed') === '1' && window.innerWidth >= 768) {
                document.documentElement.classList.add('sidebar-collapsed');
            }
        })();
    </script>
    <HeadOutlet/>
    <title>База українських запитань</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700&family=Nunito:wght@600;700;800&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["QuestionsHub.Blazor.styles.css"]"/>
    <link rel="icon" type="image/x-icon" href="favicon.ico"/>
    <link rel="apple-touch-icon" href="images/icon.png"/>
</head>

<body>
<Routes/>
<script>window.__iconsSvgUrl = '@Assets["icons.svg"]';</script>
<script src="@Assets["lib/bootstrap/dist/js/bootstrap.bundle.min.js"]"></script>
<script src="@Assets["question-card.js"]"></script>
<script src="@Assets["favorites.js"]"></script>
<script src="@Assets["adult-content.js"]"></script>
<script src="@Assets["forms.js"]"></script>
<script src="@Assets["navigation.js"]"></script>
<script src="@Assets["theme.js"]"></script>
<script src="@Assets["date-formatter.js"]"></script>
@if (NeedsBlazorScript)
{
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
    <script src="@Assets["sortable-interop.js"]"></script>
    <script>
        // blazor.web.js resumes an evicted circuit with Promise.withResolvers (Safari 17.4+)
        if (!Promise.withResolvers) {
            Promise.withResolvers = function () {
                let resolve, reject;
                const promise = new Promise(function (res, rej) { resolve = res; reject = rej; });
                return { promise: promise, resolve: resolve, reject: reject };
            };
        }
    </script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        if (window.Blazor) {
            // Every page loads in full, as without this script: no enhanced navigation or form handling.
            // So NavigationManager.NavigateTo must always pass forceLoad: true (NavigateToTests).
            Blazor.start({ ssr: { disableDomPreservation: true } });
        } else {
            // The browser could not parse blazor.web.js (Safari before 16.4): say so instead of dead buttons
            document.body.insertAdjacentHTML('afterbegin',
                '<div class="alert alert-warning rounded-0 mb-0 text-center">Інструменти редактора потребують новішого браузера (на iPhone — iOS 16.4 або новіша).</div>');
        }
    </script>
}
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    /// <summary>
    /// Public pages are plain server-rendered HTML and work without Blazor's script, which needs a
    /// current browser (Safari 16.4+ parses it; iOS 16.1 does not). It is loaded only for the
    /// interactive editing tools: for editors and admins, and on any page marked <c>@@rendermode</c>.
    /// </summary>
    private bool NeedsBlazorScript =>
        HttpContext.User.IsInRole("Editor")
        || HttpContext.User.IsInRole("Admin")
        || HttpContext.GetEndpoint()?.Metadata.GetMetadata<ComponentTypeMetadata>()?.Type
            .IsDefined(typeof(RenderModeAttribute), inherit: true) == true;
}
