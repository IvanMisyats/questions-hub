@using Microsoft.AspNetCore.Components.Endpoints
@using Microsoft.AspNetCore.Components.Sections
<!DOCTYPE html>
<html lang="uk">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <ImportMap />
    <script>
        (function() {
            const stored = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = stored || (prefersDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', theme);
            // Prevent sidebar collapse flash on refresh
            if (localStorage.getItem('sidebar-collapsed') === '1' && window.innerWidth >= 768) {
                document.documentElement.classList.add('sidebar-collapsed');
            }
        })();
    </script>
    <HeadOutlet/>
    <title>База українських запитань</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700&family=Nunito:wght@600;700;800&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["QuestionsHub.Blazor.styles.css"]"/>
    <link rel="icon" type="image/x-icon" href="favicon.ico"/>
    <link rel="apple-touch-icon" href="images/icon.png"/>
</head>

<body>
<Routes/>
<script>window.__iconsSvgUrl = '@Assets["icons.svg"]';</script>
<script src="@Assets["lib/bootstrap/dist/js/bootstrap.bundle.min.js"]"></script>
<script src="@Assets["question-card.js"]"></script>
<script src="@Assets["favorites.js"]"></script>
<script src="@Assets["adult-content.js"]"></script>
<script src="@Assets["forms.js"]"></script>
<script src="@Assets["navigation.js"]"></script>
<script src="@Assets["theme.js"]"></script>
<script src="@Assets["date-formatter.js"]"></script>
<script src="@Assets["protected-links.js"]"></script>
<SectionOutlet SectionName="@BlazorScript.SectionName" />
@if (PageIsInteractive)
{
    <BlazorScript />
}
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    /// <summary>
    /// Public pages are plain server-rendered HTML and work without Blazor's script, which needs a
    /// current browser (Safari 16.4+ parses it; iOS 16.1 does not). It is loaded only where an
    /// interactive tool is: on pages marked <c>@@rendermode</c>, and where a static page renders
    /// <see cref="BlazorScript"/> next to its interactive part.
    /// </summary>
    private bool PageIsInteractive =>
        HttpContext.GetEndpoint()?.Metadata.GetMetadata<ComponentTypeMetadata>()?.Type
            .IsDefined(typeof(RenderModeAttribute), inherit: true) == true;
}
